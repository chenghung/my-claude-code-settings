# Keys for the Graphiti MCP server (services/graphiti/docker-compose.yml).
# Copy this file to ~/.config/graphiti/.env and fill in the values there.
# Never put real keys in this repo.

# Anthropic API key, used for entity extraction with claude-haiku-5-5.
# Create it in the Console organization that receives your Claude plan's
# monthly API credit, inside a workspace made just for graphiti with a spend
# limit set, so graphiti's cost is capped and shown on its own.
ANTHROPIC_API_KEY=

# OpenAI API key, used for embeddings (text-embedding-3-small) and for
# reranking search results.
OPENAI_API_KEY=
