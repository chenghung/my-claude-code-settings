{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(php:*)",
      "Bash(composer:*)",
      "Bash(./vendor/bin/phpstan:*)",
      "Bash(./vendor/bin/pest:*)",
      "Bash(./vendor/bin/phpunit:*)",
      "Bash(./vendor/bin/phpcbf:*)",
      "Bash(./vendor/bin/phpcs:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(kubectl get:*)",
      "Bash(kubectl logs:*)",
      "Bash(kubectl describe:*)",
      "Bash(helm template:*)",
      "Bash(gcloud:*)",
      "Bash(python3:*)",
      "Bash(curl:*)",
      "Bash(ping:*)",
      "Bash(ls:*)",
      "Bash(tree:*)",
      "Bash(test:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(chmod:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(sed:*)",
      "Bash(rg:*)",
      "Bash(mkdir:*)",
      "Bash(diff:*)",
      "Bash(which:*)",
      "Bash(date:*)",
      "Bash(trello:*)",
      "Bash(echo:*)",
      "Bash(jq:*)",
      "Bash(awk:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(tee:*)",
      "Bash(xargs:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(hackmd-cli:*)",
      "Bash(terraform:*)",
      "Bash(markdownlint-cli2:*)",
      "Bash(rtk:*)",
      "Read(///**)",
      "WebSearch",
      "WebFetch(domain:*)",
      "mcp__sequentialThinking__sequentialthinking",
      "mcp__time__get_current_time",
      "mcp__time__convert_time",
      "mcp__ide__getDiagnostics",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "Skill(planning-with-files:*)",
      "mcp__codegraph__*"
    ],
    "deny": [],
    "defaultMode": "acceptEdits"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify-cc.sh done"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify-cc.sh notify"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codegraph prompt-hook"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "vtsls@claude-code-lsps": true,
    "phpactor@claude-code-lsps": true,
    "php-lsp@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "teams-channel-post-writer@daymade-skills": true,
    "example-skills@anthropic-agent-skills": true,
    "document-skills@anthropic-agent-skills": true,
    "skill-creator@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "warp@claude-code-warp": true,
    "understand-anything@understand-anything": true,
    "pyright-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    },
    "understand-anything": {
      "source": {
        "source": "github",
        "repo": "Lum1104/Understand-Anything"
      }
    }
  },
  "language": "Traditional Chinese",
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "autoMemoryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
